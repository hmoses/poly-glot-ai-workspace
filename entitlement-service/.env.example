NODE_ENV=production
ENTITLEMENT_PORT=8790
DATABASE_URL=postgres://user:password@host:5432/polyglot

# OAuth/OIDC used by ChatGPT to authenticate Poly-Glot users.
POLYGLOT_OIDC_ISSUER=https://YOUR-AUTH-DOMAIN.example
POLYGLOT_OIDC_AUDIENCE=polyglot-mcp
# POLYGLOT_OIDC_JWKS_URL=https://YOUR-AUTH-DOMAIN.example/.well-known/jwks.json

# Sign in with Apple identity token audience. For native-only Sign in with Apple this is normally your bundle id.
APPLE_SIGN_IN_AUDIENCE=ai.polyglot.workspace
APPLE_BUNDLE_ID=ai.polyglot.workspace
APPLE_APP_ID=6804499285
APPLE_ENVIRONMENT=PRODUCTION
APPLE_ONLINE_CHECKS=true
APPLE_ROOT_CA_PATHS=/run/secrets/AppleRootCA-G3.cer,/run/secrets/AppleRootCA-G2.cer

POLYGLOT_MONTHLY_PRODUCT_IDS=ai.polyglot.promptstudio.mac.subscription.monthly,ai.polyglot.workspace.pro.monthly
POLYGLOT_ANNUAL_PRODUCT_IDS=ai.polyglot.mac.pro.annual.2704,ai.polyglot.workspace.pro.annual
