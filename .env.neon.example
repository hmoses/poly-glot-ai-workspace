# POLY-GLOT NEON-ONLY ENVIRONMENT TEMPLATE
# Never commit real secrets. Neon Functions can inject DATABASE_URL automatically.

NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
PGPOOL_MAX=5

# Public URL of the Neon entitlement Function after deployment.
POLYGLOT_ENTITLEMENT_ENDPOINT=https://YOUR-NEON-FUNCTION/v1/entitlements/me
POLYGLOT_TRIAL_START_ENDPOINT=https://YOUR-NEON-FUNCTION/v1/trials/start

# MCP / OIDC verification
POLYGLOT_AUTH_ISSUER=https://YOUR-ISSUER
POLYGLOT_AUTH_AUDIENCE=YOUR-AUDIENCE
POLYGLOT_AUTH_JWKS_URL=https://YOUR-ISSUER/.well-known/jwks.json

# Sign in with Apple verification
APPLE_CLIENT_ID=ai.polyglot.workspace.mac
APPLE_ISSUER=https://appleid.apple.com

# Apple App Store server verification
APPLE_BUNDLE_ID=ai.polyglot.workspace.mac
APPLE_APP_ID=YOUR_NUMERIC_APP_ID
APPLE_ENVIRONMENT=Production
APPLE_ROOT_CERTS_DIR=/secure/apple-root-certs

POLYGLOT_MONTHLY_PRODUCT_IDS=ai.polyglot.promptstudio.mac.subscription.monthly
POLYGLOT_ANNUAL_PRODUCT_IDS=ai.polyglot.mac.pro.annual.2704
